<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NativeElements.ViewModels"
             x:Class="NativeElements.CushionCalculatorPage"
             Title="Cushion">

    <ContentPage.BindingContext>
        <vm:CushionViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="16" MaximumWidthRequest="960" HorizontalOptions="Center">

            <!-- Page Header -->
            <VerticalStackLayout Spacing="2" Margin="0,4,0,8">
                <Label Text="Cushion Calculator" Style="{StaticResource PageTitle}" />
                <Label Text="Calculate fabric requirements for boxed and throw cushions" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <!-- Parameters Card -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="CUSHION DIMENSIONS" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                        <!-- Type -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Cushion Type" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker SelectedItem="{Binding CushionType}">
                                    <Picker.Items>
                                        <x:String>Throw</x:String>
                                        <x:String>Back</x:String>
                                        <x:String>Seat</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Quantity -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="Quantity" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding Quantity}" Keyboard="Numeric" Placeholder="e.g. 1" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Width -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="Finished Width (cm)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding WidthCm}" Keyboard="Numeric" Placeholder="e.g. 50" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Depth -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="Finished Depth (cm)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding DepthCm}" Keyboard="Numeric" Placeholder="e.g. 50" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Boxed Height -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                            <Label Text="Boxed Height (cm)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding BoxedHeightCm}" Keyboard="Numeric" Placeholder="e.g. 10" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Seam Allowance -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                            <Label Text="Seam Allowance (cm)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding SeamAllowanceCm}" Keyboard="Numeric" Placeholder="e.g. 1.5" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Shrinkage -->
                        <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                            <Label Text="Shrinkage Factor" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding ShrinkageFactor}" Keyboard="Numeric" Placeholder="e.g. 0.05" />
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- Toggle Options -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource ToggleRow}">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Piping" VerticalOptions="Center"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasPiping}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ToggleRow}">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Inner Lining" VerticalOptions="Center"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasInnerLining}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                <Button Text="Calculate"   Clicked="OnCalculateAndPreviewClicked" Style="{StaticResource PrimaryButton}"   Margin="0,0,10,10" />
                <Button Text="Preview"     Clicked="OnPreviewClicked"             Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Text="Export PDF"  Clicked="OnExportClicked"             Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Text="Print"       Clicked="OnPrintClicked"              Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Text="Export DXF"  Clicked="OnExportDxfClicked"          Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" />
            </FlexLayout>

            <!-- Results -->
            <Border Style="{StaticResource ResultBorder}">
                <Label Text="{Binding ResultText, TargetNullValue='Enter parameters above and tap Calculate.'}"
                       Style="{StaticResource ResultText}" />
            </Border>

            <!-- Preview -->
            <Border Style="{StaticResource PreviewBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="PREVIEW" Style="{StaticResource SectionTitle}" />
                    <GraphicsView x:Name="CushionPreview" HeightRequest="500"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Card}, Dark={StaticResource CardDark}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
