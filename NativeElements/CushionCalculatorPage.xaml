<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NativeElements.ViewModels"
             x:Class="NativeElements.CushionCalculatorPage"
             Title="Cushion">

    <ContentPage.BindingContext>
        <vm:CushionViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid Padding="20">
            <VerticalStackLayout MaximumWidthRequest="960"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <Label Text="Cushion Calculator" FontSize="22" FontAttributes="Bold" />

                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <Label Grid.Row="0" Grid.Column="0" Text="Type" VerticalTextAlignment="Center" />
                    <Picker Grid.Row="0" Grid.Column="1" SelectedItem="{Binding CushionType}">
                        <Picker.Items>
                            <x:String>Throw</x:String>
                            <x:String>Back</x:String>
                            <x:String>Seat</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Grid.Row="1" Grid.Column="0" Text="Finished Width (cm)" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding WidthCm}" Keyboard="Numeric" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Finished Depth (cm)" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding DepthCm}" Keyboard="Numeric" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Boxed Height (cm)" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="3" Grid.Column="1" Text="{Binding BoxedHeightCm}" Keyboard="Numeric" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Seam Allowance (cm)" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding SeamAllowanceCm}" Keyboard="Numeric" />

                    <Label Grid.Row="5" Grid.Column="0" Text="Shrinkage (e.g. 0.05)" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="5" Grid.Column="1" Text="{Binding ShrinkageFactor}" Keyboard="Numeric" />

                    <Label Grid.Row="6" Grid.Column="0" Text="Quantity" VerticalTextAlignment="Center" />
                    <Entry Grid.Row="6" Grid.Column="1" Text="{Binding Quantity}" Keyboard="Numeric" />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="Piping" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding HasPiping}" />
                    <Label Grid.Column="2" Text="Inner Lining" VerticalOptions="Center" />
                    <Switch Grid.Column="3" IsToggled="{Binding HasInnerLining}" />
                </Grid>

                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                    <Button Margin="0,0,10,10" Text="Calculate" Clicked="OnCalculateAndPreviewClicked" />
                    <Button Margin="0,0,10,10" Text="Preview" Clicked="OnPreviewClicked" />
                    <Button Margin="0,0,10,10" Text="Export PDF" Clicked="OnExportClicked" />
                    <Button Margin="0,0,10,10" Text="Print" Clicked="OnPrintClicked" />
                    <Button Margin="0,0,10,10" Text="Export DXF" Clicked="OnExportDxfClicked" />
                </FlexLayout>

                <Label Text="Results" FontAttributes="Bold" />
                <Label Text="{Binding ResultText}" LineBreakMode="WordWrap" />

                <Label Text="Preview" FontAttributes="Bold" />
                <GraphicsView x:Name="CushionPreview" HeightRequest="500" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
