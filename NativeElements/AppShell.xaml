<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NativeElements.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NativeElements"
    Title="NativeElements">

    <TabBar>
        <Tab Title="Petal">
            <ShellContent>
                <local:PetalPage />
            </ShellContent>
        </Tab>
        <Tab Title="Ring">
            <ShellContent>
                <local:SegmentedRingPage />
            </ShellContent>
        </Tab>
        <Tab Title="Cushion">
            <ShellContent>
                <local:CushionCalculatorPage />
            </ShellContent>
        </Tab>
        <Tab Title="History">
            <ShellContent>
                <local:HistoryPage />
            </ShellContent>
        </Tab>
        <Tab Title="Tools">
            <ShellContent>
                <local:DeveloperPage />
            </ShellContent>
        </Tab>
        <Tab Title="Settings">
            <ShellContent>
                <local:SettingsPage />
            </ShellContent>
        </Tab>
    </TabBar>

</Shell>
