<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NativeElements.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NativeElements"
    Title="NativeElements">

    <TabBar>
        <Tab Title="Petal">
            <ShellContent ContentTemplate="{DataTemplate local:PetalPage}" />
        </Tab>
        <Tab Title="Ring">
            <ShellContent ContentTemplate="{DataTemplate local:SegmentedRingPage}" />
        </Tab>
        <Tab Title="Cushion">
            <ShellContent ContentTemplate="{DataTemplate local:CushionCalculatorPage}" />
        </Tab>
        <Tab Title="History">
            <ShellContent ContentTemplate="{DataTemplate local:HistoryPage}" />
        </Tab>
        <Tab Title="Tools">
            <ShellContent ContentTemplate="{DataTemplate local:DeveloperPage}" />
        </Tab>
        <Tab Title="Settings">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
