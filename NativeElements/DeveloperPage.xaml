<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NativeElements.DeveloperPage"
             Title="Tools">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Developer Tools" FontSize="24" FontAttributes="Bold" />
        <Button x:Name="RunTestsButton" Text="Run Cushion Unit Tests" Clicked="OnRunTestsClicked" />
        <ScrollView HeightRequest="400">
            <Label x:Name="TestOutputLabel" Text="Test output will appear here" LineBreakMode="WordWrap" />
        </ScrollView>
    </VerticalStackLayout>

</ContentPage>