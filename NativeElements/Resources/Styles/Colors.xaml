<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════════════
         NativeElements Design Palette
         Brand: deep navy · Accent: warm amber · Surface: soft grey-blue
         ═══════════════════════════════════════════════════ -->

    <!-- Brand (navy) -->
    <Color x:Key="Brand">#1E3A5F</Color>
    <Color x:Key="BrandMedium">#2563EB</Color>
    <Color x:Key="BrandLight">#DBEAFE</Color>
    <Color x:Key="BrandDark">#60A5FA</Color>

    <!-- Accent (amber) -->
    <Color x:Key="Accent">#D97706</Color>
    <Color x:Key="AccentLight">#FEF3C7</Color>
    <Color x:Key="AccentDark">#F59E0B</Color>

    <!-- Surfaces -->
    <Color x:Key="Surface">#F1F4F9</Color>
    <Color x:Key="SurfaceDark">#0D1526</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardDark">#1A2642</Color>
    <Color x:Key="CardAlt">#F8FAFD</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#0F1928</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextPrimaryDark">#EFF6FF</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <!-- Borders -->
    <Color x:Key="OutlineLight">#DDE3EE</Color>
    <Color x:Key="OutlineDark">#2A3B58</Color>

    <!-- Status colours -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessLight">#D1FAE5</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="ErrorLight">#FEE2E2</Color>

    <!-- ── Legacy keys kept for framework / control compatibility ── -->
    <Color x:Key="Primary">#1E3A5F</Color>
    <Color x:Key="PrimaryDark">#60A5FA</Color>
    <Color x:Key="PrimaryDarkText">#EFF6FF</Color>
    <Color x:Key="Secondary">#DBEAFE</Color>
    <Color x:Key="SecondaryDarkText">#2563EB</Color>
    <Color x:Key="Tertiary">#D97706</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0D1526</Color>

    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush"  Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush"    Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush"    Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush"  Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush"  Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush"  Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush"  Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush"  Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush"  Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush"  Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush"  Color="{StaticResource Gray950}"/>

</ResourceDictionary>