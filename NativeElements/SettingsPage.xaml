<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NativeElements.ViewModels"
             x:Class="NativeElements.SettingsPage"
             Title="Settings">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Application Settings" FontSize="20" FontAttributes="Bold" />

            <Label Text="DPI (affects rendering & export)" />
            <Entry Text="{Binding Dpi}" Keyboard="Numeric" />

            <Label Text="Page Size" />
            <Picker Title="Page Size" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />

            <Label Text="Tile Overlap (cm)" />
            <Entry Text="{Binding OverlapCm}" Keyboard="Numeric" />

            <Button Text="Save" Command="{Binding SaveSettingsCommand}" />
            <Button Text="Reset" Command="{Binding ResetSettingsCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>