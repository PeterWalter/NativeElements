<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NativeElements.ViewModels"
             x:Class="NativeElements.SettingsPage"
             Title="Settings">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="16" MaximumWidthRequest="700" HorizontalOptions="Center">

            <!-- Page Header -->
            <VerticalStackLayout Spacing="2" Margin="0,4,0,8">
                <Label Text="Application Settings" Style="{StaticResource PageTitle}" />
                <Label Text="Configure export quality and page layout preferences" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <!-- Settings Card -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="RENDERING &amp; EXPORT" Style="{StaticResource SectionTitle}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="DPI (affects rendering &amp; export quality)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding Dpi}" Keyboard="Numeric" Placeholder="e.g. 300" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Page Size" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker Title="Select page size" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tile Overlap (cm)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding OverlapCm}" Keyboard="Numeric" Placeholder="e.g. 0.5" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="12">
                <Button Text="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Text="Reset to Defaults" Command="{Binding ResetSettingsCommand}" Style="{StaticResource SecondaryButton}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>