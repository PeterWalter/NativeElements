<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NativeElements.Views.PreviewPage"
             Title="Preview">

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="10" Spacing="10">
            <Button Text="Refresh" Clicked="OnRefreshClicked" />
            <Button Text="Export" Clicked="OnExportClicked" />
        </HorizontalStackLayout>
        
        <Label Grid.Row="1" Text="Preview rendering requires SkiaSharp.Views.Maui support for .NET 10" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
    </Grid>

</ContentPage>
